MANIFEST

# PyInstaller 빌드 파일
#   보통 파이썬 스크립트가 템플릿으로 이 파일들을 만든다.
#   PyInstaller는 이를 이용해 실행 파일에 날짜 등의 정보를 넣는다.
*.manifest
*.spec

# 설치 로그
pip-log.txt
pip-delete-this-directory.txt

# 단위 테스트 및 코드 커버리지 보고서
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
*.lcov
.hypothesis/
.pytest_cache/
cover/

# 번역 파일
*.mo
*.pot

# Django 로그, 로컬 설정 및 데이터베이스
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask 인스턴스 및 자원 캐시
instance/
.webassets-cache

# Scrapy 작업 디렉터리
.scrapy

# Sphinx 문서 빌드 결과
docs/_build/

# PyBuilder 빌드 파일
.pybuilder/
target/

# Jupyter Notebook 체크포인트
.ipynb_checkpoints

# IPython 프로필 및 설정
profile_default/
ipython_config.py

# pyenv 버전 설정
#   여러 환경을 지원하는 라이브러리나 패키지는 버전 파일을 제외할 수 있다.
#   실행 환경을 프로젝트에서 지정하는 경우에는 저장소에 포함한다.
# .python-version

# pipenv 의존성 잠금 파일
#   pypa/pipenv#598에서는 Pipfile.lock을 버전 관리에 포함하도록 권장한다.
#   특정 플랫폼에서만 동작하는 의존성이 있다면, 다른 플랫폼에서 pipenv를 실행할 때
#   호환되지 않는 패키지가 설치되거나 필요한 패키지가 빠질 수 있다.
# Pipfile.lock

# uv 의존성 잠금 파일
#   Pipfile.lock과 마찬가지로 uv.lock도 일반적으로 버전 관리에 포함한다.
#   바이너리 패키지는 빌드 재현성을 위해 잠금 파일을 포함하고, 라이브러리는 제외하기도 한다.
# uv.lock

# poetry 의존성 및 설정 파일
#   Pipfile.lock과 마찬가지로 poetry.lock도 일반적으로 버전 관리에 포함한다.
#   바이너리 패키지는 빌드 재현성을 위해 잠금 파일을 포함하고, 라이브러리는 제외하기도 한다.
#   https://python-poetry.org/docs/basic-usage/#commit-your-poetrylock-file-to-version-control
# poetry.lock
# poetry.toml

# pdm 의존성 및 설정 파일
#   Pipfile.lock과 마찬가지로 pdm.lock도 일반적으로 버전 관리에 포함한다.
#   pdm은 프로젝트 공통 설정인 pdm.toml을 저장소에 포함하고 .pdm-python은 제외하도록 권장한다.
#   https://pdm-project.org/en/latest/usage/project/#working-with-version-control
# pdm.lock
# pdm.toml
.pdm-python
.pdm-build/

# pixi 의존성 및 가상 환경
#   Pipfile.lock과 마찬가지로 pixi.lock도 일반적으로 버전 관리에 포함한다.
# pixi.lock
#   venv로 .venv에 가상 환경을 만들듯이 Pixi는 .pixi에 가상 환경을 만든다.
#   이 디렉터리는 버전 관리에서 제외하는 것이 일반적이다.
.pixi/*
!.pixi/config.toml

# PEP 582 로컬 패키지 디렉터리 (github.com/David-OConnor/pyflow 및 github.com/pdm-project/pdm 등에서 사용)
__pypackages__/

# Celery 주기 작업 스케줄러의 상태 및 프로세스 파일
celerybeat-schedule*
celerybeat.pid

# Redis 데이터 및 프로세스 파일
*.rdb
*.aof
*.pid

