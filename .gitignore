rabbitmq/
rabbitmq-data/

# ActiveMQ 데이터 디렉터리
activemq-data/

# SageMath가 변환한 파이썬 파일
*.sage.py

# 환경 설정과 가상 환경
.env
.envrc
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

